{
  // TypeScript is used only to check JSDoc types and generate .d.ts files.
  // The package itself is plain JavaScript, so there is no build step.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "types",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src"]
}
